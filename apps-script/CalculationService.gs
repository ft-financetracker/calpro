function saveCalculation_(data){validate_(data);const lock=LockService.getScriptLock();lock.waitLock(10000);try{const sh=getSpreadsheet_().getSheetByName('CALCULATION_HISTORY');const values=sh.getDataRange().getValues();if(values.slice(1).some(row=>row[1]===data.requestId))return{ok:true,duplicate:true,calculationId:data.calculationId};const now=new Date();sh.appendRow([data.calculationId,data.requestId,data.tenantId,data.userId,CP_CONFIG.APP_ID,data.calculatorCode,data.title||'',JSON.stringify(data.input||{}),JSON.stringify(data.result||{}),'ACTIVE','SYNCED',data.createdAt||now,data.userId,now,data.userId,'','']);appendDetails_(data,now);audit_(data,'CALCULATION_CREATE','SUCCESS',now);return{ok:true,calculationId:data.calculationId,syncedAt:now.toISOString()}}finally{lock.releaseLock()}}
function appendDetails_(data,now){if(data.calculatorCode!=='CASH_DEPOSIT'||!data.input||!Array.isArray(data.input.denominations))return;const sh=getSpreadsheet_().getSheetByName('CASH_COUNT_DETAIL');const rows=data.input.denominations.map(x=>[`DTL-${Utilities.getUuid()}`,data.calculationId,x.value,x.quantity,x.value*x.quantity,now]);if(rows.length)sh.getRange(sh.getLastRow()+1,1,rows.length,rows[0].length).setValues(rows)}
function validate_(data){['calculationId','requestId','tenantId','userId','calculatorCode'].forEach(key=>{if(!data[key])throw new Error(`Field wajib: ${key}`)});if(data.appId&&data.appId!==CP_CONFIG.APP_ID)throw new Error('APP_ID tidak valid');if(JSON.stringify(data).length>30000)throw new Error('Payload terlalu besar')}
function audit_(data,action,result,now){getSpreadsheet_().getSheetByName('AUDIT_LOG').appendRow([`AUD-${Utilities.getUuid()}`,data.requestId,data.tenantId,data.userId,CP_CONFIG.APP_ID,action,'CALCULATION',data.calculationId,result,'',now])}
