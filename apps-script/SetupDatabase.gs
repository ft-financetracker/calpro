function setupCalProDatabase(){const ss=getSpreadsheet_(),now=new Date();Object.keys(CP_SHEETS).forEach(name=>{let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);const headers=CP_SHEETS[name];sh.clear();sh.getRange(1,1,1,headers.length).setValues([headers]).setFontWeight('bold').setBackground('#0B132B').setFontColor('#FFFFFF');sh.setFrozenRows(1);sh.autoResizeColumns(1,headers.length)});seedConfig_(now);seedCalculators_(now);return{ok:true,message:'CalPro Database berhasil dibuat',spreadsheetId:ss.getId()}}
function seedConfig_(now){const sh=getSpreadsheet_().getSheetByName('APP_CONFIG');sh.getRange(2,1,4,4).setValues([['APP_ID',CP_CONFIG.APP_ID,'Permanent application identifier',now],['APP_VERSION',CP_CONFIG.VERSION,'Current application version',now],['DEV_TENANT_ID',CP_CONFIG.DEV_TENANT_ID,'Development only',now],['DEV_USER_ID',CP_CONFIG.DEV_USER_ID,'Development only',now]])}
function seedCalculators_(now){const sh=getSpreadsheet_().getSheetByName('CALCULATOR_MASTER');sh.getRange(2,1,5,9).setValues([['CASH_DEPOSIT','Setoran Kas','CASH','Hitung semua pecahan uang','cash',10,'ACTIVE',now,now],['SELLING_PRICE','Harga & HPP','SALES','HPP, biaya lainnya, margin, dan laba','sell',20,'ACTIVE',now,now],['PRODUCTION_HPP','HPP Produksi','PRODUCTION','Biaya produksi dan HPP estimasi per produk','inventory_2',30,'ACTIVE',now,now],['DISCOUNT','Diskon','SALES','Harga akhir dan penghematan','percent',40,'ACTIVE',now,now],['MARKETPLACE_FEE','Biaya Marketplace','SALES','Fee dan penerimaan bersih','storefront',50,'ACTIVE',now,now]])}
function getSpreadsheet_(){if(CP_CONFIG.SPREADSHEET_ID==='PASTE_SPREADSHEET_ID_HERE')throw new Error('Isi SPREADSHEET_ID pada Config.gs');return SpreadsheetApp.openById(CP_CONFIG.SPREADSHEET_ID)}
